# By tutor-contrib-notifications
{% if NOTIFICATIONS_SEND_COURSE_UPDATE or NOTIFICATIONS_SEND_RECURRING_NUDGE %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: notifications-emails
  labels:
    app.kubernetes.io/name: notifications-emails
spec:
  schedule: "{{ NOTIFICATIONS_DAILY_SCHEDULE }}"
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/name: notifications-emails
        spec:
          restartPolicy: Never
          containers:
            - name: notifications-emails
              image: {{ DOCKER_IMAGE_OPENEDX }}
              env:
                - name: SERVICE_VARIANT
                  value: lms
                - name: DJANGO_SETTINGS_MODULE
                  value: lms.envs.tutor.production
              volumeMounts:
                - mountPath: /openedx/edx-platform/lms/envs/tutor/
                  name: settings-lms
                - mountPath: /openedx/edx-platform/cms/envs/tutor/
                  name: settings-cms
                - mountPath: /openedx/config
                  name: config
              command:
                - /bin/sh
                - -c
                - {% if NOTIFICATIONS_SEND_COURSE_UPDATE %}./manage.py lms send_course_update{% if NOTIFICATION_JOBS_SITE_DOMAIN %} {{ NOTIFICATION_JOBS_SITE_DOMAIN }}{% endif %}; {% endif %}{% if NOTIFICATIONS_SEND_RECURRING_NUDGE %}./manage.py lms send_recurring_nudge{% if NOTIFICATION_JOBS_SITE_DOMAIN %} {{ NOTIFICATION_JOBS_SITE_DOMAIN }}{% endif %}; {% endif %}
          volumes:
            - name: settings-lms
              configMap:
                name: openedx-settings-lms
            - name: settings-cms
              configMap:
                name: openedx-settings-cms
            - name: config
              configMap:
                name: openedx-config
{% endif %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: scheduled-instructor-tasks
  labels:
    app.kubernetes.io/name: scheduled-instructor-tasks
spec:
  schedule: "{{ NOTIFICATIONS_INSTRUCTOR_TASKS_SCHEDULE }}"
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/name: scheduled-instructor-tasks
        spec:
          restartPolicy: Never
          containers:
            - name: scheduled-instructor-tasks
              image: {{ DOCKER_IMAGE_OPENEDX }}
              env:
                - name: SERVICE_VARIANT
                  value: lms
                - name: DJANGO_SETTINGS_MODULE
                  value: lms.envs.tutor.production
              volumeMounts:
                - mountPath: /openedx/edx-platform/lms/envs/tutor/
                  name: settings-lms
                - mountPath: /openedx/edx-platform/cms/envs/tutor/
                  name: settings-cms
                - mountPath: /openedx/config
                  name: config
              command:
                - /bin/sh
                - -c
                - ./manage.py lms process_scheduled_instructor_tasks
          volumes:
            - name: settings-lms
              configMap:
                name: openedx-settings-lms
            - name: settings-cms
              configMap:
                name: openedx-settings-cms
            - name: config
              configMap:
                name: openedx-config
# End of tutor-contrib-notifications
